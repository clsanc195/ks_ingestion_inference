# Copy to .env and fill in.
ANTHROPIC_API_KEY=

KGI_NEO4J_URI=bolt://localhost:7687
KGI_NEO4J_USER=neo4j
KGI_NEO4J_PASSWORD=kgi-local-dev

KGI_QDRANT_URL=http://localhost:6333

# LangGraph durable checkpointer (survives restarts across human wait states)
KGI_POSTGRES_DSN=postgresql://kgi:kgi-local-dev@localhost:5432/kgi

KGI_EXTRACTION_MODEL=claude-sonnet-5

# Routing thresholds (L8): auto-approve >= hi, auto-reject < lo, else review
KGI_ROUTE_AUTO_APPROVE=0.92
KGI_ROUTE_AUTO_REJECT=0.30
